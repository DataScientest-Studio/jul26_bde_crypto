    {
      "type": "timeseries",
      "title": "Appels par seconde, par route",
      "id": 9,
      "description": "Toutes les routes de l'API. /positions : un tour de carnet (Airflow ou interface).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (handler) (rate(http_requests_total{job=\"api\", handler!~\"/metrics\"}[5m]))",
          "legendFormat": "{{handler}}",
          "refId": "A"
