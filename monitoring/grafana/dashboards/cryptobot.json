    {
      "type": "table",
      "title": "Duels",
      "id": 22,
      "description": "Chaque semaine (ou sur derive forte), le modele en service et un nouveau modele sont mesures sur les 21 derniers jours, que le nouveau n'a jamais vus. Style conservateur.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cryptobot-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptobot-postgres"
          },
          "rawSql": "SELECT lance_le AS \"Lance le\", date_coupure AS \"Donnees jusqu'au\", champion_version AS \"Champion\", round(champion_accuracy::numeric, 4) AS \"Accuracy champion\", challenger_version AS \"Challenger\", round(challenger_accuracy::numeric, 4) AS \"Accuracy challenger\", challenger_ordres AS \"Ordres\", decision AS \"Decision\", raison AS \"Raison\" FROM reentrainements ORDER BY lance_le DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    }
