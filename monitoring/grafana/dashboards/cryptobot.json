    {
      "type": "timeseries",
      "title": "Derive : PSI median par serie",
      "id": 14,
      "description": "Ecart entre les 90 derniers jours et les donnees d'apprentissage du modele en service. Au-dessus de 0,10 : derive moderee ; au-dessus de 0,25 : forte. Une mesure par jour.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cryptobot-postgres"
      },
      "gridPos": {
        "x": 10,
        "y": 20,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptobot-postgres"
          },
          "rawSql": "SELECT mesure_le AS time, symbol || ' ' || interval AS metric, psi_median AS value FROM derive_mesures WHERE $__timeFilter(mesure_le) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
