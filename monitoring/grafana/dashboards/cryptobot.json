      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=~\"api|exportateur\"}",
          "legendFormat": "{{job}}",
          "refId": "A",
          "instant": true,
          "range": false
