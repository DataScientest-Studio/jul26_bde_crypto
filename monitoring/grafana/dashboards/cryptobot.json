    {
      "type": "timeseries",
      "title": "Temps de reponse (95e centile)",
      "id": 10,
      "description": "95 % des appels sont plus rapides que cette valeur. /graphique sur un an lit 35 000 bougies aupres de Binance : il est normalement le plus lent.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"api\", handler!~\"/metrics|/health\"}[5m])))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Erreurs, refus de cle et pannes de sources",
      "id": 11,
      "description": "Un pic de refus 'cle_invalide' = client mal configure ou tentative d'intrusion.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_requests_total{job=\"api\", status=~\"4xx|5xx\"}[5m]))",
          "legendFormat": "reponses {{status}}",
          "refId": "A"
