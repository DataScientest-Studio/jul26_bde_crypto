    {
      "type": "timeseries",
      "title": "Capital virtuel (10 000 EUR, 5 % par position)",
      "id": 19,
      "description": "Ce que serait devenu un capital de 10 000 EUR sur la periode affichee.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cryptobot-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptobot-postgres"
          },
          "rawSql": "SELECT fermee_a AS time, interval || ' ' || style AS metric, 10000 * exp(sum(ln(1 + 0.05 * rendement_net_pct / 100)) OVER (PARTITION BY interval, style ORDER BY fermee_a)) AS value FROM positions_virtuelles WHERE statut <> 'ouverte' AND $__timeFilter(fermee_a) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "currencyEUR"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Derniers trades",
      "id": 20,
      "description": "Les 50 derniers trades fermes, tous pas de temps et styles.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cryptobot-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptobot-postgres"
          },
          "rawSql": "SELECT fermee_a AS \"Ferme le\", symbol AS \"Paire\", interval AS \"Pas\", style AS \"Style\", CASE sens WHEN 1 THEN 'achat' ELSE 'vente' END AS \"Sens\", statut AS \"Issue\", round(rendement_net_pct::numeric, 3) AS \"Gain net %\" FROM positions_virtuelles WHERE statut <> 'ouverte' ORDER BY fermee_a DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Reentrainement : champion contre challenger",
      "id": 21,
      "collapsed": false,
