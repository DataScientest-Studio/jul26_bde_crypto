# Copier en .env et adapter si besoin. Les valeurs par defaut suffisent
# pour un usage local : docker-compose.yml et src/database.py les partagent.
#
# .env n'est PAS versionne (voir .gitignore).

POSTGRES_DB=cryptobot
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=cryptobot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MONGO_DB=cryptobot
MONGO_USER=cryptobot
MONGO_PASSWORD=cryptobot
MONGO_HOST=localhost
MONGO_PORT=27017
