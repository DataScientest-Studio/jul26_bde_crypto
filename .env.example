# =============================================================================
#  Configuration locale de CryptoBot
#
#  NE PAS copier ce fichier a la main : lancer
#      python -m scripts.generer_secrets
#  qui cree .env en remplacant chaque __A_GENERER__ par une valeur aleatoire.
#  Un .env existant n'est jamais ecrase : seules les valeurs manquantes sont
#  ajoutees.
#
#  .env n'est PAS versionne (voir .gitignore) : il contient les secrets.
# =============================================================================

# --- Services demarres par `docker compose up -d` ----------------------------
#   (vide)       bases + API + interface : le produit seul
#   pipeline     Airflow (collecte, bot, derive, reentrainement) + MLflow
#   supervision  Prometheus + Grafana + exportateur de metriques
#   outils       pgAdmin + mongo-express, pour regarder les bases
COMPOSE_PROFILES=pipeline,supervision,outils

# --- Bases du projet -----------------------------------------------------------
# Les identifiants des bases existantes ne changent pas sans les recreer
# (docker compose down -v) : les valeurs par defaut sont gardees en local.
POSTGRES_DB=cryptobot
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=cryptobot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MONGO_DB=cryptobot
MONGO_USER=cryptobot
MONGO_PASSWORD=cryptobot
MONGO_HOST=localhost
MONGO_PORT=27017

# --- API : une cle par client (voir api/securite.py) ---------------------------
CRYPTOBOT_CLE_INTERFACE=__A_GENERER__
CRYPTOBOT_CLE_AIRFLOW=__A_GENERER__

# --- Interface -------------------------------------------------------------------
# 127.0.0.1 : la page n'est joignable que depuis cette machine. Mettre 0.0.0.0
# pour l'ouvrir au reseau local (une demonstration sur un autre poste).
INTERFACE_ECOUTE=127.0.0.1
INTERFACE_PORT=8080

# --- Airflow ---------------------------------------------------------------------
AIRFLOW_PORT=8088
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=__A_GENERER__
AIRFLOW_DB_PASSWORD=__A_GENERER__
# Chiffre les mots de passe des connexions stockees par Airflow.
AIRFLOW_FERNET_KEY=__A_GENERER_FERNET__
# Signe les jetons echanges entre le planificateur et l'API d'execution.
AIRFLOW_JWT_SECRET=__A_GENERER__
AIRFLOW_API_SECRET_KEY=__A_GENERER__

# --- MLflow ----------------------------------------------------------------------
MLFLOW_PORT=5000

# --- Supervision -----------------------------------------------------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=__A_GENERER__
# Compte PostgreSQL en LECTURE SEULE utilise par Grafana.
GRAFANA_DB_PASSWORD=__A_GENERER__
PROMETHEUS_PORT=9090

# --- Outils d'exploration (profil "outils") --------------------------------------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@cryptobot.fr
PGADMIN_PASSWORD=__A_GENERER__
MONGO_EXPRESS_PORT=8081
