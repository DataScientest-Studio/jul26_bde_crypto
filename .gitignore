# Donnees collectees : volumineuses et regenerables via les scripts.
# Seul le fichier d'exemple du livrable (samples/) est versionne.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.idea/
.vscode/

# Extrait fige : volumineux, partage hors depot
data/extract/*
!data/extract/manifest.json

# Modeles et suivi MLflow : volumineux et REGENERABLES depuis l'extrait fige
# par `python -m scripts.train_final`. Les captures et les metriques JSON,
# elles, sont versionnees car ce sont les livrables.
models/*.joblib
mlartifacts/
mlflow.db
