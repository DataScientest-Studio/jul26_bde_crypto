# Image de l'API CryptoBot (et de l'exportateur de metriques, meme code).
#
# Le MODELE n'est pas copie dans l'image : il pese une centaine de Mo et
# change a chaque reentrainement. Il est monte depuis ./models au demarrage
# (voir docker-compose.yml), ce qui evite de reconstruire l'image pour un
# nouveau modele.
FROM python:3.13-slim

WORKDIR /app

# Les dependances d'abord, dans leur propre couche : tant que
# requirements-api.txt ne change pas, Docker reutilise cette etape.
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY src/ src/
COPY api/ api/

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

# Utilisateur sans droits : si une faille permettait d'executer du code dans
# l'API, il n'aurait pas les droits root du conteneur. Le code et le modele
# (monte en lecture seule) restent lisibles, rien n'est modifiable.
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin cryptobot
USER cryptobot

EXPOSE 8000

# Sonde de sante : Docker redemarre le conteneur si l'API ne repond plus.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
